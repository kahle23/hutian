<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.kahle23</groupId>
        <artifactId>baibao-spring-boot-standard-parent</artifactId>
        <version>1.0.3</version>
        <relativePath/>
    </parent>

    <groupId>io.github.kahle23</groupId>
    <artifactId>hutian-boot</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>hutian-boot</name>
    <description>壶天 - 启动装配：唯一可执行模块（启动类/登录/跨域/健康检查），产出 fat jar.</description>

    <properties>
        <!-- 覆盖父 pom 的 baibao 默认版本：父 pom 的 baibao 是实际依赖（每个模块的直接依赖），
             不覆盖会被 nearest-wins 解析成父 pom 默认版本，压过经 hutian-common 传递的版本造成静默降级 -->
        <baibao.version>1.0.29</baibao.version>
        <!-- 本模块（fat jar 装配者）自身的 dependencyManagement 钉住全图版本：
             不覆盖会把 easyexcel 钉成父 pom 默认 3.1.1、poi 钉成 5.2.1，
             压过经 hutian-basic/system/cms 传递的 easyexcel 3.3.4（poi 4.1.2），造成运行时版本漂移 -->
        <easyexcel.version>3.3.4</easyexcel.version>
        <poi.version>4.1.2</poi.version>
        <!-- 前端工程目录（同级仓库 hutian-web），fat jar 打包时自动构建并复制其 dist 产物 -->
        <frontend.dir>${project.basedir}/../../hutian-web</frontend.dir>
        <!-- 复用系统 PATH 里的 npm（Windows 由 os-windows profile 覆盖为 npm.cmd） -->
        <frontend.npm.executable>npm</frontend.npm.executable>
        <!-- 后端-only 打包时 -DskipFrontendBuild=true 跳过前端构建 -->
        <skipFrontendBuild>false</skipFrontendBuild>
        <!-- maven filtering 填充 application.yml 的 @xx@ 占位符（默认 dev，-P test 切换） -->
        <applicationVersion>${project.version}</applicationVersion>
        <activatedProfile>dev</activatedProfile>
    </properties>

    <dependencies>

        <dependency>
            <groupId>io.github.kahle23</groupId>
            <artifactId>hutian-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.kahle23</groupId>
            <artifactId>hutian-basic</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.kahle23</groupId>
            <artifactId>hutian-system</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.kahle23</groupId>
            <artifactId>hutian-cms</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 代码生成器（按需手工触发，仅测试类路径） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-generator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>hutian-boot</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <executable>true</executable>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 前端联动自动装配：检测到 ../hutian-web 在场（package.json 存在）时激活，
             用系统 npm 构建前端并把 dist 复制进 fat jar 的 static 目录；前端仓库不在场时自动跳过 -->
        <profile>
            <id>frontend</id>
            <activation>
                <!-- 不用 activeByDefault：只要任何其他 profile 激活（如 os-windows），
                     所有 activeByDefault 的 profile 会集体失效（Maven 经典坑）；
                     file.exists 单独作为激活条件即可：前端仓库在场即激活。
                     注意 activation 段插值早于本 POM <properties>，须用内置 ${basedir}
                     而非自定义 ${frontend.dir}（后者此时尚未就绪，条件永远不成立） -->
                <file>
                    <exists>${basedir}/../../hutian-web/package.json</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <!-- 复用系统 Node/npm（exec 直调，不额外下载运行时）；
                         须声明在 maven-resources-plugin 之前：generate-resources 阶段按声明顺序执行 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <configuration>
                            <workingDirectory>${frontend.dir}</workingDirectory>
                            <executable>${frontend.npm.executable}</executable>
                            <skip>${skipFrontendBuild}</skip>
                        </configuration>
                        <executions>
                            <execution>
                                <id>frontend-npm-install</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <arguments>
                                        <argument>install</argument>
                                        <argument>--registry=https://registry.npmmirror.com</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>frontend-npm-build</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-frontend-dist</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${frontend.dir}/dist</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Windows 下 npm 是 npm.cmd，Runtime.exec 不会自动解析裸名 npm -->
        <profile>
            <id>os-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <frontend.npm.executable>npm.cmd</frontend.npm.executable>
            </properties>
        </profile>

        <!-- 切 test 环境：覆盖 @activatedProfile@ 占位符。
             不用 activeByDefault：本 pom 里 os-windows（Windows 上恒激活）/frontend 等条件 profile
             一旦激活，activeByDefault 的 profile 会集体失效，@activatedProfile@ 将不被替换 -->
        <profile>
            <id>test</id>
            <properties>
                <activatedProfile>test</activatedProfile>
            </properties>
        </profile>
    </profiles>

</project>
